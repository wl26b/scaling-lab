# systemd service for the Node app. Installed to /etc/systemd/system/app.service by deploy/install.sh.
[Unit]
Description=scaling-lab app
After=network.target postgresql.service

[Service]
WorkingDirectory=/opt/app/current
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=POOL_SIZE=10
# Where the database is: written by the instance's first-boot script (differs per stage)
EnvironmentFile=/etc/app/app.env
Restart=always
User=www-data
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
